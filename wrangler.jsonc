{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "davisfurniturewholesale",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "not_found_handling": "none",
    "run_worker_first": [
      "/api/*",
      "/product/*",
      "/welcome-webmaster/products/edit/*"
    ]
  },
  "kv_namespaces": [
    {
      "binding": "DAVIS_STORAGE",
      "id": "469a73e86b524a34901ff0358e1988cb"
    }
  ]
}

